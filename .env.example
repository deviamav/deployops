# DeployOps — environment configuration

# === DB ===
DATABASE_URL="postgresql://deployops:deployops_pwd@localhost:5433/deployops?schema=public"
# Used by docker/docker-compose.yml (local PostgreSQL)
POSTGRES_PASSWORD="deployops_pwd"

# === Auth ===
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="generate-via-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# Auth.js v5 also supports AUTH_SECRET (preferred name)
AUTH_SECRET="generate-via-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# === Encryption key for SSH credentials (32 bytes, base64) ===
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DEPLOYOPS_SECRET_KEY=""

# === Bootstrap of the first admin ===
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change_me_strong"

# === pgAdmin (docker) ===
PGADMIN_EMAIL="admin@example.com"
PGADMIN_PASSWORD="admin"

# === Limits ===
UPLOAD_MAX_SIZE_MB=512
ZIP_MAX_ENTRIES=10000
ZIP_MAX_TOTAL_BYTES=524288000

# === Rate limit (deploy launches per user per minute) ===
DEPLOYOPS_RATE_LIMIT_PER_MIN=5
