# SECURITY: захист від supply-chain атак (event-stream/ua-parser-js/colors-style).
#
# 1) ignore-scripts=true — НЕ виконуємо postinstall у залежностей за замовчуванням.
#    Pnpm 10+ це робить за замовчуванням, але дублюємо явно — на випадок старшого pnpm/npm.
#    Якщо потрібен нативний модуль (sharp, ssh2, bcrypt) — викликаємо pnpm approve-builds
#    і додаємо в pnpm.onlyBuiltDependencies (див. package.json).
ignore-scripts=true

# 2) audit-level=high — `pnpm install` падає на high/critical advisories.
audit-level=high

# 3) При деплої завжди --frozen-lockfile (через CI/setup.sh). Тут дублюємо для локалі.
prefer-frozen-lockfile=true

# 4) Не публікуємо випадково.
private=true

# 5) Не використовуємо link-mode=hardlinks (іноді ламає на Windows).
# (default settings ОК)
